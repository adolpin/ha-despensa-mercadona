          "error": "Error",
          "unknown": "Unknown"
        }
      },
      "token_days_left": {
        "name": "Days until token expiry"
      },
      "cart_count": {
        "name": "Products in cart"
      },
      "pending_ops": {
        "name": "Pending operations"
      }
    }
  },
  "selector": {
    "mode": {
      "options": {
        "ensure": "Ensure present (no extra units)",
        "add": "Add units"
      }
    }
  },
  "services": {
    "add_product": {
      "name": "Add product",
      "description": "Add a product to the Mercadona cart by text, EAN or id.",
