        "text": {
          "name": "Text",
          "description": "Product name."
        },
        "ean": {
          "name": "EAN",
          "description": "Barcode."
        },
        "product_id": {
          "name": "Product id",
          "description": "Mercadona id."
        },
        "qty": {
          "name": "Quantity",
          "description": "Units or kg."
        },
        "mode": {
          "name": "Mode",
          "description": "ensure or add."
        },
        "source": {
          "name": "Source",
          "description": "Who asks."
        },
        "learn_text": {
          "name": "Learn text",
          "description": "With product id: remember this text."
        }
      }
    },
    "choose_candidate": {
      "name": "Choose candidate",
      "description": "Add the chosen product of an ambiguous request.",
      "fields": {
        "request_id": {
          "name": "Request",
