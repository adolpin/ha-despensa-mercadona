        },
        "product_id": {
          "name": "Product id",
          "description": "One of the candidates."
        },
        "callback": {
          "name": "Telegram button",
          "description": "Pressed button data; replaces the other two fields."
        }
      }
    },
    "more_candidates": {
      "name": "More candidates",
      "description": "Return the next candidates of an ambiguous request.",
      "fields": {
        "request_id": {
          "name": "Request",
          "description": "request_id from mercadona_unresolved."
        }
      }
